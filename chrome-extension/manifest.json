{
  "manifest_version": 3,
  "name": "LeadLite - Sales Navigator to CRM",
  "version": "1.1.0",
  "description": "1-click send leads from LinkedIn Sales Navigator to LeadLite CRM (https://leadlite.netlify.app)",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.linkedin.com/*",
    "https://leadlite.netlify.app/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.linkedin.com/sales/*",
        "https://*.linkedin.com/in/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Send to LeadLite",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}